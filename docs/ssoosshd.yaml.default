# ssoosshd example configuration
#
# This file documents every option ssoosshd's config struct accepts
# (see server/config/types.go). Everything is commented out; ssoosshd
# merges this against its built-in defaults (server/config/defaults.yaml)
# and whatever real config file it loads, in that order, so you only need
# to uncomment and set the values you want to override.
#
# To use this file, copy it to one of the search locations below and
# uncomment the settings you want to override, or pass its path via
# the --config flag.
#
# Config file search order (first found wins):
#   1. The file specified by the --config flag (if set)
#   2. ./ssoosshd.yaml (current directory — useful for development)
#   3. /etc/ssoosshd.yaml (system-wide configuration)
#   4. /etc/ssoossh/ssoosshd.yaml (ssoossh-specific directory)
#
# If no config file is found, ssoosshd runs with only the built-in
# defaults (server/config/defaults.yaml).
#
# Durations (anything with a "duration" name below) use Go's
# time.Duration string syntax, e.g. "30s", "10m", "8760h". There is no
# unit larger than "h" (hours) — for multi-day/year durations, do the
# multiplication yourself (e.g. 1 year = 8760h).

# ----------------------------------------------------------------------
# logging - configures the application's main structured log output.
# Backed by log/slog, with file rotation via timberjack.
# Default: WARN level, include app name and version, human-readable text.
# ----------------------------------------------------------------------
# logging:
  ## Minimum level to emit. One of: DEBUG, INFO, WARN, ERROR.
  # level: WARN

  ## Also copy log output to stdout, in addition to any Filename below.
  ## Useful when running under a supervisor (systemd, docker) that
  ## captures stdout, or when Filename is left empty.
  # enable_stdout: false

  ## Prefix every log line with the application name.
  # include_app_name: true

  ## Prefix every log line with the running application version.
  # include_app_version: true

  ## Emit logs as JSON (structured) instead of human-readable text.
  ## Recommended true in production so logs are machine-parseable.
  # log_json: false

  ## --- The following fields come from the embedded timberjack.Logger
  ## --- and control log file rotation. All are optional; if Filename
  ## --- is empty, no file is written (only enable_stdout applies).

  ## Path to the log file. Rotated backups are written alongside it in
  ## the same directory. If empty, defaults to a temp-dir file named
  ## after the process.
  # filename: /var/log/ssoossh/ssoosshd.log

  ## Maximum size in megabytes a log file may reach before it is
  ## rotated. Defaults to 100 if unset.
  # maxsize: 100

  ## Maximum number of days to retain rotated log files, based on the
  ## timestamp encoded in their filename. A "day" here is exactly 24h.
  ## 0 (default) means files are never removed based on age alone.
  # maxage: 0

  ## Maximum number of old rotated log files to keep. 0 (default) keeps
  ## all of them (subject to maxage still deleting old ones).
  # maxbackups: 0

  ## Use local time (instead of UTC, the default) when formatting the
  ## timestamp embedded in rotated backup filenames.
  # localtime: false

  ## Compression algorithm applied to rotated backups. One of:
  ## "none", "gzip", "zstd". If empty, falls back to the deprecated
  ## "compress" boolean below.
  # compression: gzip

  ## Deprecated: use "compression" above instead. true is equivalent to
  ## compression: gzip.
  # compress: false

  ## Maximum duration between rotations, independent of file size. E.g.
  ## 24h rotates the log daily even if it never reaches maxsize. 0
  ## (default) disables time-based rotation.
  # rotationinterval: 24h

  ## Go time-layout string used for the timestamp appended to rotated
  ## backup filenames. Falls back to "2006-01-02T15-04-05.000" if
  ## invalid.
  # backuptimeformat: "2006-01-02-15-04-05"

  ## Specific minutes within every hour (0-59) at which to force a
  ## rotation, e.g. [0] for the top of the hour, [0, 30] for top and
  ## half-past. Applies in addition to rotationinterval/maxsize.
  # rotateAtMinutes: []

  ## Specific times of day ("HH:MM") at which to force a rotation, e.g.
  ## ["00:00"] for midnight. Applies in addition to
  ## rotationinterval/maxsize.
  # rotateAt: []

  ## Controls where the rotation timestamp/reason are placed in the
  ## backup filename. false (default): name-timestamp-reason.log.
  ## true: name.log-timestamp-reason.
  # appendTimeAfterExt: false

  ## Unix file permissions used when creating new/rotated log files
  ## (octal). Defaults to 0640 if unset. Subject to the process umask.
  # filemode: 0640

# ----------------------------------------------------------------------
# ssh_key - the SSH CA private key ssoosshd uses to sign issued
# certificates. Inline PEM, not a file path.
# ----------------------------------------------------------------------
# ssh_key: |
#   -----BEGIN OPENSSH PRIVATE KEY-----
#   -----END OPENSSH PRIVATE KEY-----

# ----------------------------------------------------------------------
# fips - steers the server toward FIPS 140-3 approved algorithms. Null
# (unset, the default) follows the Go runtime's own FIPS 140-3 mode
# (crypto/fips140.Enabled()); true/false overrides that detection.
#
# When in effect, a non-FIPS-approved algorithm is a hard error, not a
# warning:
#   - a client-submitted public key that isn't ECDSA or RSA, rejected both
#     when a request is approved and again by the signer itself
#   - the CA key itself, checked at startup (ed25519 fails to start)
#   - http.tls.curves/cipher_suites: an explicit list must resolve
#     entirely within the FIPS-approved sets (P-256/384/521 curves;
#     AES-GCM cipher suites, not ChaCha20-Poly1305); left unset, they
#     default to those sets instead of Go's own defaults
# ----------------------------------------------------------------------
# fips:

# ----------------------------------------------------------------------
# production - toggles production-mode behavior (e.g. stricter
# defaults/validation). Set true when actually deploying.
# ----------------------------------------------------------------------
# production: true

# ----------------------------------------------------------------------
# traces / metrics - enable OpenTelemetry traces and metrics export.
# Further configuration is done via environment variables per the OpenTelemetry
# SDK specification: https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
#
# PROMETHEUS METRICS ENDPOINT:
# To enable a Prometheus-compatible metrics scraping endpoint, set:
#   OTEL_METRICS_EXPORTER=prometheus
# This starts a second HTTP server on a separate port. Configure it with:
#   OTEL_EXPORTER_PROMETHEUS_HOST=localhost  (default: 0.0.0.0)
#   OTEL_EXPORTER_PROMETHEUS_PORT=9464       (default: 9464)
#
# ----------------------------------------------------------------------
# traces: false
# metrics: false

# multi_instance - declares this is a multi-instance deployment. Required to
# enable the following startup checks: http.cookie_key must be explicitly set
# (not per-process random), and certain features adapt for cross-instance
# message delivery. See deployment.md section 7 for multi-instance setup.
# Default: false (single instance, gochannel in-process broker).
#
# multi_instance: false

# ----------------------------------------------------------------------
# pubsub - message broker configuration (certificate pipeline, approval flow).
# Default: gochannel (in-process). Set backend: nats for multi-instance.
# See deployment.md section 7 for NATS setup and mTLS requirements.
# ----------------------------------------------------------------------
# pubsub:
  ## Backend broker: "gochannel" (default, in-process) or "nats" (multi-instance)
  # backend: gochannel

  ## NATS configuration (only used when backend: nats)
  # nats:
    ## NATS server URL, e.g. "nats://nats.example.com:4222"
    # url: ""

    ## mTLS client certificate (PEM format). Required when url is set.
    # cert_file: "/path/to/client-cert.pem"

    ## mTLS client certificate key (PEM format). Required when url is set.
    # key_file: "/path/to/client-key.pem"

    ## CA certificate to verify NATS server (PEM format). Required when url is set.
    # ca_file: "/path/to/ca-cert.pem"

# ----------------------------------------------------------------------
# db - database connection, query logging, and connection retry behavior.
# ----------------------------------------------------------------------
# db:
  ## Which backend to use. One of: sqlite, postgres.
  # provider: sqlite

  ## Connection string / DSN. For sqlite this is a file path (or
  ## ":memory:"); for postgres a standard postgres:// URL or keyword
  ## string.
  # connection_string: "ssoossh.db"

  ## Maximum number of connection attempts before giving up. 0 or negative
  ## disables retries (fails immediately on the first error). Typical values
  ## range from 1-5 depending on tolerance for startup delays.
  # retry_attempts: 3

  ## Time to wait between connection retry attempts. Only used when
  ## retry_attempts > 1. Typical values range from milliseconds to seconds
  ## depending on expected transient failure duration.
  # retry_interval: 3s

  ## Database operation logging. Same shape/rotation options as top-level
  ## "logging" above (embeds timberjack.Logger), plus:
  ## To disable database logging entirely, set filename to /dev/null.
  # logging:
    ## Minimum level to emit for DB operation logs: DEBUG, INFO, WARN, ERROR.
    # level: WARN

    ## Include the source file:line that issued the operation in each log
    ## entry. Useful for tracking down slow/unexpected queries.
    # add_source: false

    ## Emit DB logs as JSON instead of human-readable text.
    # log_json: false
    # filename: /dev/null  # Uncomment to disable database logging

    ## filename / maxsize / maxage / maxbackups / localtime / compress /
    ## compression / rotationinterval / backuptimeformat /
    ## rotateAtMinutes / rotateAt / appendTimeAfterExt / filemode: see
    ## the top-level "logging" section above — identical fields,
    ## applied to the database operation log instead.

# ----------------------------------------------------------------------
# http - the HTTP(S) server: bind address, TLS, rate limiting, access
# logging, and OIDC authentication.
# ----------------------------------------------------------------------
# http:
  ## Interface address and port to listen on.
  # address: 127.0.0.1
  # port: 8080

  ## Listen on a Unix domain socket instead of TCP. When set, address/port
  ## above are ignored. Mutually exclusive with proxy_protocol (PROXY
  ## protocol is a TCP-connection concept).
  # unix_socket: ""

  ## CIDR ranges of reverse proxies trusted to prefix TCP connections with a
  ## PROXY protocol v1/v2 header, so the real client address survives a
  ## TCP-level proxy. Different from trusted_proxies below, which is for
  ## HTTP-level proxies setting X-Forwarded-For. Empty disables PROXY
  ## protocol entirely and rejects connections from anywhere else once set.
  ## Ignored (must be empty) when unix_socket is set.
  # proxy_protocol: []

  ## CIDR ranges of reverse proxies trusted to set
  ## X-Forwarded-For/X-Forwarded-Proto. Empty (default) means no proxy is
  ## trusted, so the client IP is always the direct TCP peer and a
  ## client-supplied X-Forwarded-For is ignored — gin's own default is to
  ## trust every proxy, so this has to be set explicitly behind a reverse
  ## proxy for approver client-IP logging (see keyid template fields) to be
  ## accurate.
  # trusted_proxies: []

  ## Cookie signing/encryption key for session cookies. Keep secret;
  ## rotating it invalidates existing sessions. Empty generates random key at startup.
  # cookie_key: ""

  ## Marks the session cookie Secure, so browsers only send it over HTTPS.
  ## Unset (the default) derives it from whether the deployment is HTTPS at
  ## all — see is_https/public_url below. Set explicitly only to override
  ## that inference.
  # cookie_secure:

  ## Session cookie SameSite attribute: "strict" (default), "lax", or
  ## "none". Strict is correct for this server — nothing legitimately
  ## navigates into it from another site. Defence in depth, not the CSRF
  ## control; state-changing routes are additionally guarded by CSRF
  ## middleware regardless of this setting.
  # cookie_same_site: strict

  ## How long a session cookie remains valid. Note: 0 does not mean "no
  ## expiry" — it falls back to a 12h default applied in code. Set an
  ## explicit positive duration to mean what it says.
  # cookie_max_age: 300s

  ## Rate limiting: max requests per rate_duration window, per client.
  # rate_limit: 60
  # rate_duration: 1m
  ## Disable all rate limiting (global and per-endpoint) for local development.
  ## Only effective when production=false, so it cannot be enabled in production.
  # rate_limit_disable_for_dev: false

  ## Per-endpoint rate limits for certificate request creation (requests per
  ## second per client IP). These apply in addition to the global rate_limit
  ## above — both must be satisfied. Zero or negative disables that endpoint's
  ## limit. A request exceeding any limit gets a 429 Too Many Requests response.
  # cert_request_rate_limit:
    # user: 10              # POST /api/certs/user (interactive user)
    # host_sign: 5          # POST /api/certs/host/sign (first host cert)
    # service_enroll: 5     # POST /api/certs/service/enroll (service enrollment)
    # pam: 10               # POST /api/certs/pam (short-lived PAM cert)

  ## Rate limit for service enrollment code redemption (POST
  ## /api/certs/service/retrieve), keyed on the enrollment code to protect
  ## against brute-forcing. Applies per code, independent of IP. Zero or
  ## negative disables this limit. A request exceeding the limit gets a 429
  ## Too Many Requests response.
  # service_code_rate_limit:
    # limit: 1              # Requests per second per enrollment code

  ## HTTP Strict-Transport-Security header value to send. Only sent when
  ## server terminates TLS. Empty disables the header.
  # hsts: "max-age=31536000; includeSubDomains"

  ## The scheme and host browsers actually reach this deployment at, e.g.
  ## "https://ssh.example.com". Set it whenever that differs from what
  ## address/port/tls describe — which is every reverse-proxy deployment,
  ## since the proxy terminates TLS on 443 while this process listens on
  ## plain HTTP somewhere else. Two things are derived from it and cannot
  ## be got right without it: the OIDC redirect URI handed to the identity
  ## provider, and the origin the CSRF check compares against. Origin only
  ## — a path, query, or fragment is rejected at startup.
  # public_url: ""

  ## Set true when a reverse proxy terminates TLS and this process serves
  ## plain HTTP. Redundant if public_url is set — its scheme settles the
  ## same question, so configure one or the other, not both.
  # is_https: false

  ## Server name to validate incoming requests against. When set, requests
  ## addressed to a different Host (or SNI on TLS connections) are rejected
  ## with 421 Misdirected Request. Empty disables the check. Health endpoints
  ## (/healthz, /ping) are registered before this check so they always work
  ## regardless of Host, which is useful for load balancer probes.
  # server_name: ""

  ## --- access_logging: which fields to record for each HTTP request. All
  ## --- default to false except the three marked below, so turning on
  ## --- body logging is opt-in (request/response bodies may contain
  ## --- sensitive data — see server/CLAUDE.md's "never log sensitive
  ## --- data" rule before enabling those).
  ## To disable access logging entirely, set filename to /dev/null.
  # access_logging:
    # log_user_agent: true
    # log_request_header: true
    # log_client_ip: true
    # log_request_id: false
    # log_request_body: false
    # log_response_body: false
    # log_response_header: false
    # log_span_id: false
    # log_trace_id: false
    # log_json: false
    # filename: /dev/null  # Uncomment to disable access logging

    ## filename / maxsize / maxage / maxbackups / localtime / compress /
    ## compression / rotationinterval / backuptimeformat /
    ## rotateAtMinutes / rotateAt / appendTimeAfterExt / filemode: see
    ## the top-level "logging" section above — identical fields,
    ## applied to the access log instead.

  ## --- tls: certificate material can be provided inline (certificate /
  ## --- private_key) or as file paths (certificate_file /
  ## --- private_key_file). If none of the four are set, the server
  ## --- runs without TLS — do not do this outside of local dev.
  # tls:
    # certificate: |
    #   -----BEGIN CERTIFICATE-----
    #   -----END CERTIFICATE-----
    # private_key: |
    #   -----BEGIN PRIVATE KEY-----
    #   -----END PRIVATE KEY-----

    # certificate_file: /etc/ssoossh/tls/server.crt
    # private_key_file: /etc/ssoossh/tls/server.key

    ## Minimum negotiated TLS version. Accepts loose forms: "TLS1.2",
    ## "tls12", "VersionTLS12", "TLS-1-2" all resolve the same way.
    ## One of: TLS1.0, TLS1.1 (both deprecated per RFC 8996 and will log
    ## a warning if selected), TLS1.2, TLS1.3.
    # min_version: TLS1.3

    ## Cipher suites allowed, by crypto/tls name, most-preferred first.
    ## Only meaningful for TLS 1.2 and below — TLS 1.3 suite selection
    ## is not configurable in Go's stdlib. Duplicate names are silently
    ## deduplicated, keeping the first occurrence's order.
    ##
    ## When the top-level fips setting is in effect, an explicit list here
    ## must resolve entirely to FIPS-approved AES-GCM suites (not
    ## ChaCha20-Poly1305, not CBC-mode) or the server fails to start; left
    ## unset, it defaults to the FIPS-approved suites instead of Go's own
    ## defaults.
    # cipher_suites:
    #   - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
    #   - TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA
    #   - TLS_RSA_WITH_AES_256_GCM_SHA384
    #   - TLS_RSA_WITH_AES_256_CBC_SHA

    ## Elliptic curves offered during the TLS handshake, most-preferred
    ## first. Accepts loose forms: "P256", "p256", "CurveP256", "P-256"
    ## all resolve the same way. Duplicates are silently deduplicated,
    ## keeping the first occurrence's order.
    ##
    ## Under fips (see above), an explicit list here must resolve entirely
    ## to P-256/384/521 (not X25519, not X25519MLKEM768) or the server
    ## fails to start; left unset, it defaults to those curves instead of
    ## Go's own defaults.
    # curves:
    #   - CurveP256
    #   - CurveP384
    #   - CurveP521

    ## Prefer the server's cipher_suites order over the client's during
    ## negotiation, instead of letting the client pick. Only affects
    ## TLS 1.2 and below.
    # prefer_server_cipher_suites: true

# ----------------------------------------------------------------------
# ldap - optional identity enrichment, looked up by the username OIDC
# resolved. Accepted by the config loader but not yet consumed by the
# authentication service — setting "enabled: true" today has no effect.
# Not yet built (see docs/changes-next.md). Documented here only so the
# gap between "the config parser accepts this" and "the server acts on it"
# is not a surprise.
# ----------------------------------------------------------------------
# ldap:
  # enabled: false
  # url: ""
  # bind_dn: ""
  # bind_password: ""
  # base_dn: ""
  # user_filter: ""

# ----------------------------------------------------------------------
# authentication - the OIDC provider used to authenticate users. This is a
# top-level section, not a subsection of "http" above.
# ----------------------------------------------------------------------
# authentication:
  # client_id: ""
  # client_secret: ""

  ## Base URL of the OIDC provider. Do not include the trailing
  ## "/.well-known/openid-configuration" — that's appended for you.
  # provider_url: ""

  ## Space-separated OAuth scopes to request. "openid" is added
  ## automatically and does not need to be listed here.
  # scopes: "profile email"

  ## --- fields: maps ssoossh's own identity concepts to claim names
  ## --- in the OIDC provider's ID token, in case your provider uses
  ## --- non-standard claim names.
  # fields:
    ## Claim to use as the SSH username. Required — ssoosshd cannot
    ## issue a certificate without one.
    # username: preferred_username

    ## Claim to use for group membership, consulted against the
    ## require_group settings under cert_options below. Groups feed the
    ## lifetime/authorization decision only — they never appear in a
    ## certificate.
    # groups: groups

    ## Claim to read the user's email from. Empty falls back to the
    ## standard "email" claim; absence is not an error either way.
    # email: email

    ## Claims holding JSON arrays of alternate account identifiers this
    ## identity is known by, and service accounts it may enroll
    ## certificates for. Both default to unset ("not populated from OIDC").
    # other_accounts: ""
    # service_accounts: ""

# ----------------------------------------------------------------------
# cert_options - issuance rules for each SSH certificate type ssoosshd
# can sign: user, service, and host.
# ----------------------------------------------------------------------
# cert_options:
  ## How long a pending certificate request (user, host, or service) stays
  ## valid for approval before it's treated as expired. Shared across all
  ## three types — this is "how stale can an unapproved request get," not
  ## a per-type concept like valid_duration below.
  # request_ttl: 5m

  ## How long an approved request may sit awaiting signature before a
  ## background sweep treats it as stranded and fails it (see
  ## docs/signing-pipeline.md). A healthy signature takes milliseconds;
  ## this only needs to be generous enough for a slow signing backend
  ## under load.
  # signing_timeout: 5m

  ## --- user: certificates issued to an interactively-authenticated
  ## --- person, for their own SSH sessions.
  # user:
    ## How long an issued user certificate remains valid. Kept short —
    ## these function as a short-lived auth token, not a long-lived key.
    # valid_duration: 30s

    ## SSH certificate extensions (capabilities) granted to the holder.
    # extensions:
    #   - "permit-X11-forwarding"
    #   - "permit-agent-forwarding"
    #   - "permit-port-forwarding"
    #   - "permit-pty"
    #   - "permit-user-rc"

    ## Key ID template (Go text/template, see docs/certificate-keyid-template.md).
    ## Empty uses the built-in default. This is also the fallback used by
    ## service and host below when their own key_id_template is empty.
    # key_id_template: ""

  ## --- service: certificates for non-interactive accounts/processes
  ## --- (e.g. CI runners, service accounts), rather than a human
  ## --- session.
  # service:
    ## OIDC group (via authentication.fields.groups) required before
    ## ssoosshd will issue a service certificate to the caller.
    # require_group: "SSH Service Signers"

    ## How long an issued service certificate remains valid.
    # valid_duration: 8760h

    ## SSH certificate extensions granted to the holder.
    # extensions:
    #   - "permit-X11-forwarding"
    #   - "permit-agent-forwarding"
    #   - "permit-port-forwarding"
    #   - "permit-pty"
    #   - "permit-user-rc"

    ## Key ID template. Empty falls back to cert_options.user.key_id_template.
    # key_id_template: ""

  ## --- host: certificates issued so that clients with a
  ## --- "@cert-authority" line in their known_hosts can implicitly
  ## --- trust this server (and others signed by the same CA), instead
  ## --- of trust-on-first-use.
  # host:
    ## OIDC group required before ssoosshd will issue a host
    ## certificate to the caller.
    # require_group: "SSH Host Signers"

    ## How long an issued host certificate remains valid. Host keys are
    ## long-lived by nature, so this is typically set to the largest
    ## practical value (largest unit supported is hours: 8760h = 1 year).
    # valid_duration: 8760h

    ## Key ID template. Empty falls back to cert_options.user.key_id_template.
    # key_id_template: ""

  ## --- pam: certificates that authenticate a single local operation
  ## --- (e.g. a `sudo` call) to pam_ssoossh, validated once in-process
  ## --- and then discarded. Never enters an agent, never reused.
  # pam:
    ## OIDC group required before ssoosshd will issue a PAM certificate to
    ## the caller. Unlike every other require_group above, empty here
    ## means PAM certificates are NEVER issued rather than "anyone may" —
    ## this must be set explicitly to enable the feature at all.
    # require_group: "SSH Sudoers"

    ## How long an issued PAM certificate remains valid. Seconds, not
    ## hours or days: the certificate is validated once and thrown away.
    # valid_duration: 30s

    ## SSH certificate extensions granted to the holder. Left empty by
    ## default — permit-pty and friends are meaningless for a certificate
    ## that authenticates one local operation rather than an SSH session.
    # extensions: []

    ## Key ID template for this certificate. Does NOT fall back to the
    ## user template above if left unset (every other type does) — PAM
    ## gets its own default of "pam:{{.Username}}" so a sudo and a login
    ## by the same person stay distinguishable in audit logs.
    # key_id_template: "pam:{{.Username}}"

# ----------------------------------------------------------------------
# branding - optional customization of the login page and web UI with
# organization-specific information. All fields are optional; empty values
# mean no branding is configured. This endpoint is unauthenticated, so only
# include values that are safe for public display.
# ----------------------------------------------------------------------
# branding:
  ## Organization name displayed in the web UI (e.g., "Acme Corp").
  ## Empty disables organization-specific branding.
  # org_name: ""

  ## Filesystem path to the organization's logo image. Empty disables the logo,
  ## and the UI renders unchanged.
  ##
  ##   Formats:  PNG, JPEG, GIF, WebP, SVG
  ##   Max size: 1 MB
  ##   Rendered: 22px tall in the site header, width scales with the image's
  ##             aspect ratio up to 160px, then letterboxes. The header shows
  ##             on every page, including the pre-login page. A wide wordmark
  ##             works well. Supply roughly 2-3x the display height (44-66px)
  ##             so it stays sharp on high-DPI screens, or an SVG, which
  ##             scales at any density. The 1 MB cap is a safety limit rather
  ##             than a target: a file anywhere near it is far larger than
  ##             this needs.
  ##
  ## The file is read ONCE AT STARTUP and validated by content rather than by
  ## file extension. A path that is missing, unreadable, larger than the cap,
  ## or not actually an image is a startup failure, not a silently broken
  ## image later. Replacing the file on disk therefore requires a restart.
  ##
  ## It is served from /api/branding/logo on this server, same-origin. The
  ## config takes a path and never a URL: the login page is unauthenticated,
  ## so an external image would disclose every visitor's IP address and
  ## user-agent to a third-party host before they log in, and would make the
  ## login page depend on that host staying up. Serving it ourselves also lets
  ## the Content-Security-Policy keep img-src at 'self'.
  ##
  ## SVG is accepted, but note that an SVG is a document and can carry script.
  ## Inside the page it is loaded in an <img> tag, where script never runs.
  ## Fetching /api/branding/logo directly would render it as a document, so
  ## that response carries Content-Security-Policy: default-src 'none' to
  ## block script there too. Supply an SVG you trust: it is served to every
  ## visitor, authenticated or not.
  # logo_path: ""

  ## Plain-text message shown on the login page before authentication.
  ## Supports newlines for multi-line text. Empty disables the notice.
  # login_notice: ""
