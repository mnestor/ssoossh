{
  "name": "${localWorkspaceFolderBasename}-server",
  "service": "server", // container name from docker-compose
  "dockerComposeFile": [
    "../../docker-compose.yml",
    "../docker-compose.yml",
    "../docker-compose.local.yml"
  ],
  "workspaceFolder": "/workspace/ssoossh",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    // Lets the devcontainer start containers on the host's docker daemon.
    // Used for the old-glibc pam_ssoossh release build
    // (docs/release-phase3-pam-build-env.md) and local release rehearsals.
    // The forwarded host socket is a docker-compose.local.yml concern, not
    // this file's -- see that file for why (rootless docker, host-specific
    // path) and docs/docker-setup.md for this host's layout.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "socketPath": "/var/run/docker-host.sock"
    }
  },
  "mounts": [
    {
      "source": "/run/user/1000/docker.sock",
      "target": "/var/run/docker-host.sock",
      "type": "bind"
    }
  ],
  "initializeCommand": "scripts/devcontainer-init.sh",
  // Uncomment the next line if you want start specific services in your Docker Compose config.
  // "runServices": [],
  "shutdownAction": "none",
  "postCreateCommand": {
    // "install-node": "bash -c '. \"$NVM_DIR/nvm.sh\" && nvm install node'",
    "allow-git": "git config --global --add safe.directory /workspace/ssoossh",
    "setup-node_modules": "bash scripts/postCreate-postStartCommand.sh"
  },
  "postStartCommand": "bash scripts/postCreate-postStartCommand.sh",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
        "dev.containers.copyGitConfig": true
      },
      "extensions": [
        "davidanson.vscode-markdownlint",
        "github.copilot-chat",
        "golang.go",
        "ms-azuretools.vscode-docker", // Docker integration and linting
        "shardulm94.trailing-spaces", // Show trailing spaces
        "Gruntfuggly.todo-tree", // Highlights TODO comments
        "dnut.rewrap-revived", // rewrap comments after n characters on one line
        "vscode-icons-team.vscode-icons", // Better file extension icons
        "redhat.vscode-yaml", // Kubernetes, Drone syntax highlighting
        "bajdzis.vscode-database", // Supports connections to mysql or postgres, over SSL, socked
        "IBM.output-colorizer", // Colorize your output/test logs
        "EditorConfig.EditorConfig",
        "anthropic.claude-code"
      ]
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [
  //   3001
  // ],
  "otherPortsAttributes": {
    // Default behavior for unlisted ports
    "onAutoForward": "silent"
  },
  "portsAttributes": {
    "443": {
      "label": "SSOOSSH with tls",
      "protocol": "https"
    },
    "3001": {
      "label": "Svelte",
      "protocol": "http"
    },
    "8080": {
      "label": "SSOOSSH without tls",
      "protocol": "http"
    }
  }
}