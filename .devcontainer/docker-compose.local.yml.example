services:
  server: &base
    volumes:
      # Forward the host's docker socket so docker-outside-of-docker
      # (.devcontainer/server/devcontainer.json,
      # .devcontainer/client/devcontainer.json) can start containers.
      # Target must be /var/run/docker-host.sock -- that's the feature's
      # `socketPath` default, and its entrypoint does the gid fix-up that
      # makes the forwarded socket usable as a non-root container user.
      # Source depends on the host:
      #   rootful docker: /var/run/docker.sock
      #   rootless docker: /run/user/<host-uid>/docker.sock
      # See docs/docker-setup.md for which this host is.
      - /var/run/docker.sock:/var/run/docker-host.sock
  client:
    <<: *base
