# Builder image for Ubuntu-based CI workflows
# Includes all tools needed for code coverage, linting, building server/PAM,
# and running integration tests with HSM (SoftHSM2) and e2e testing.

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    gcc-aarch64-linux-gnu \
    pkg-config \
    # Go + Node tooling (handled by GitHub Actions setup-go/setup-node in CI,
    # but included here for completeness in standalone runs)
    ca-certificates \
    git \
    curl \
    wget \
    # Go testing and code coverage
    golang-go \
    # Node + pnpm (handled by Actions but needed for devcontainer)
    nodejs \
    npm \
    # C/POSIX development
    libpam0g-dev \
    # HSM integration (SoftHSM2 + OpenSC for PKCS#11 testing)
    softhsm2 \
    opensc \
    # Release tooling (goreleaser, other CLI tools)
    # (pre-built binaries fetched at runtime by CI actions, not in base image)
    && rm -rf /var/lib/apt/lists/*

# Zig toolchain for cross-compilation with glibc floor (2.28) and musl targets
# Downloaded and cached in CI workflows rather than baked into the image
# to keep image size manageable. When zig is needed, install via:
#   wget https://ziglang.org/download/0.14.0/zig-linux-x86_64-0.14.0.tar.xz
#   tar -xf zig-linux-x86_64-0.14.0.tar.xz -C /usr/local/bin
