# JetBrains
**/.idea

# Node
node_modules

# PNPM
.pnpm-store/

# Built frontend assets, embedded by server/frontend (//go:embed all:dist/*).
# Nothing here is tracked: the filenames are content hashes, so committing
# them would churn on every rebuild. `make frontend` produces them, and it is
# a prerequisite of building or testing the Go side at all.
/server/frontend/dist/
/frontend/.svelte-kit/
/frontend/build/

# Output
.output
.vercel
/backend/bin
/tests/test-results/*.json

# OS
.DS_Store
Thumbs.db

# Env
.env*
!.env.development-example
!.env.test
.env*.local
.secrets

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/backend/.bin
/pocket-id

# Application specific
ssoossh.db*
test*
# ...but not the committed e2e suite the pattern above would otherwise hide.
!/test/
!/test/**
!/pam_ssoossh/testing/
# Runtime diagnostics from a failing e2e run (docs/e2e-testing-plan.md) —
# generated, never committed.
/test/e2e/_artifacts/

# Misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.old/
ssl/
test-*

#Debug
**/__debug_*

#local config
ssoossh*.yaml

#test results
coverage*

#scripts that are for local only
*.local.sh
*.local.yml

# working log for pending commit message (regenerated per hook run)
.claude
CLAUDE.md

# dev stuff
.app
.data
.internal.old
.old
.pkg
downloads
devcontainer-lock.json
.claudeignore
.rtk/

# goreleaser output
/dist/

# make pam output (pam_ssoossh.so and the cgo header goreleaser generates)
/.build/
