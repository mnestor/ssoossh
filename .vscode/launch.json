{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "go",
      "request": "launch",
      // "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "APP_ENV": "development"
      },
      "envFile": [
        "${workspaceFolder}/app/.env",
        "${workspaceFolder}/app/.env.local",
      ],
      "mode": "debug",
      "program": "${workspaceFolder}/app/cmd/server/main.go",
      "buildFlags": "-tags=exclude_web",
      "cwd": "${workspaceFolder}",
      "args": [
        // "version",
        // "-v"
      ]
    },
    {
      "name": "Frontend",
      "type": "node",
      "request": "launch",
      // "envFile": "${workspaceFolder}/frontend/.env",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Development",
      "configurations": [
        "Server",
        "Frontend"
      ],
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    }
  ],
}