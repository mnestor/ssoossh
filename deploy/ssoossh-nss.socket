[Unit]
Description=ssoossh NSS daemon userdb socket
Documentation=man:ssoossh-nss(8) https://github.com/mnestor/ssoossh
# nss-user-lookup.target is the point after which user and group lookups
# are expected to work. Pulling it in and ordering this socket before it
# means that once anything waits for the target, a lookup of a directory
# user reaches this socket instead of failing because the socket is not
# there yet.
Before=nss-user-lookup.target
Wants=nss-user-lookup.target

[Socket]
# The userdb service name, com.github.mnestor.ssoossh, is the socket's file
# name: nss-systemd queries every socket in /run/systemd/userdb/ and sends
# that name in each call. systemd holds this socket across daemon restarts,
# so a lookup issued while ssoossh-nss restarts waits and then succeeds
# rather than failing (measured on systemd 252 and 257).
ListenStream=/run/systemd/userdb/com.github.mnestor.ssoossh
# World-connectable: every process on the host resolves users, setuid
# programs and unprivileged shells alike. What a caller may learn is decided
# by the daemon, which answers uid 0 peers alone with the privileged record
# section.
SocketMode=0666

[Install]
WantedBy=sockets.target
