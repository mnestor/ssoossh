[Unit]
Description=ssoossh NSS daemon: directory users and groups through systemd userdb
Documentation=man:ssoossh-nss(8) https://github.com/mnestor/ssoossh
# Socket-activated: ssoossh-nss.socket owns the listening socket and starts
# this service on the first lookup. There is deliberately no ordering after
# network-online.target. The daemon opens its cache and answers from it
# before any upstream call, and a lookup that arrives during boot would
# otherwise wait for the network to come up.
Requires=ssoossh-nss.socket
After=ssoossh-nss.socket
# Pinned rather than inherited from system.conf, so the reasoning at
# RestartSec below holds on every host: a 6th start within 60 s is refused.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
# The ssoossh-nss package installs the binary at /usr/sbin/ssoossh-nss and
# the configuration at /etc/ssoossh/nss.yaml, the daemon's default.
ExecStart=/usr/sbin/ssoossh-nss run
Restart=always
# A daemon that cannot start must reach the start limit above, and soon.
# While this service fails and restarts, systemd keeps the socket
# listening and queues every lookup that reaches it, and each one waits for
# nss-systemd's own timeout. That is every lookup on the host, local users
# included, since initgroups asks every source: measured on AlmaLinux 9.8,
# a daemon failing at start made sudo and an ssh login as a local user take
# minutes. Past the start limit the socket unit fails too, and lookups are
# a quick "not found" (measured on systemd 252 and 257) until the cause is
# fixed and `systemctl reset-failed ssoossh-nss.socket ssoossh-nss.service`
# brings the socket back.
#
# So: restart after 1 s, which a single crash costs the lookups queued
# behind it, and give up at the 5th start within a minute. A persistent
# failure stops in about 5 s; a daemon that crashes now and then, fewer
# than 5 times a minute, keeps being restarted.
RestartSec=1s

# The daemon must never resolve users through itself. nss-systemd skips
# the userdb services this variable names, and the daemon is built with
# CGO_ENABLED=0, so it never calls NSS anyway; this keeps that true if it
# ever does.
Environment=SYSTEMD_BYPASS_USERDB=com.github.mnestor.ssoossh

# --- resource limits ------------------------------------------------------
# Backstops, sized from the daemon's own bounds so that no load the daemon
# itself admits can reach them: a limit hit kills or cripples the daemon,
# and a dead daemon stalls every lookup on the host (see RestartSec above).
# They assume socket_max_connections at its default, 1024; raise all three
# with a drop-in when raising it.
#
# Descriptors: one per userdb connection (1024), one more while a uid 0
# peer's /proc/<pid>/cgroup is read (1024), the 64 connections being
# refused, the cache's SQLite files, the HTTPS connections to ssoosshd and
# the listeners: about 2200 at most. Running out makes accept fail, which
# the daemon waits out rather than exits on.
LimitNOFILE=8192
# Memory: measured at about 10 KiB per idle connection and 78 KiB for one
# holding a 64 KiB call that never ends, the worst a peer can do within
# the read timeout, so 1024 connections cost 80 MiB at most. The
# persistent cache lives in SQLite, not the heap. 512M leaves room for a
# large memory-mode cache too; GOMEMLIMIT makes the Go runtime collect
# harder before reaching it, rather than let the cgroup kill the daemon.
# Raise both together.
MemoryMax=512M
Environment=GOMEMLIMIT=400MiB
# Threads: Go runs one per CPU plus one per goroutine blocked in a system
# call, at most one per connection (a file read) and a few for the cache,
# and a thread it cannot create is a fatal error, not a refused lookup.
# 1024 connections plus a few hundred CPUs stays well under 4096.
TasksMax=4096

# /run/ssoossh-nss holds the admin socket (/run/ssoossh-nss/admin.sock) and
# /var/lib/ssoossh-nss the persistent cache (/var/lib/ssoossh-nss/cache.db).
# Not /run/ssoossh and /var/lib/ssoossh: ssoosshd.service and
# ssoossh-agent.service already own those, as user ssoossh at mode 0750, and
# systemd would fight this unit, which runs as root at 0700, over their
# owner and mode on a host running both.
RuntimeDirectory=ssoossh-nss
RuntimeDirectoryMode=0700
StateDirectory=ssoossh-nss
StateDirectoryMode=0700
UMask=0077

# --- sandboxing -----------------------------------------------------------
# Runs as root: the fleet key and nss.yaml are root-only files, and the
# daemon must see the uid of every peer. It needs no capability at all.
# The one check that looked as though it would, telling sshd apart from
# other root callers, reads /proc/<pid>/cgroup, which needs none, so the
# bounding set stays empty. (readlink of /proc/<pid>/exe would need
# CAP_SYS_PTRACE against a full-capability sshd, which is why the daemon
# does not use it.)
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
# Read, never written by the daemon. `ssoossh-nss override` edits
# nss-overrides.yaml from an administrator's shell, outside this sandbox,
# and signals the daemon to re-read it.
ReadOnlyPaths=/etc/ssoossh
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
# AF_UNIX for the userdb and admin sockets, AF_INET and AF_INET6 for the
# HTTPS connection to ssoosshd and for DNS.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Not ProtectProc=invisible: the daemon reads other processes'
# /proc/<pid>/cgroup to recognise sshd, which that would hide.

[Install]
# The socket starts the service, so the socket is what to enable; this makes
# `systemctl enable ssoossh-nss.service` enable the socket as well.
Also=ssoossh-nss.socket
