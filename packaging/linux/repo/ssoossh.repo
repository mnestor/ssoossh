# Installed by the ssoossh-release package.
#
# $releasever is expanded by dnf, not by this file: the repository is laid
# out per EL major because pam-ssoossh's OpenSSL variants are one package
# name at distinct NEVRAs (1.el8, 1.el9), and the solver has to be pointed
# at the tree for the release it is running on.
#
# repo_gpgcheck=1 as well as gpgcheck=1. The first verifies the repository
# metadata's own signature, the second each package's; without the first, a
# signed package can still be advertised by metadata nobody signed.
[ssoossh]
name=ssoossh
baseurl=https://packages.mikenestor.org/ssoossh/yum/el/$releasever/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ssoossh
