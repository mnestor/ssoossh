table certificate_request_decisions
  column accept_language type=TEXT nullable=false pk=false default=''
  column certificate_request_id type=TEXT nullable=false pk=false default=<none>
  column decided_at type=DATETIME nullable=false pk=false default=<none>
  column email type=TEXT nullable=false pk=false default=''
