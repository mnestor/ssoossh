table audit_events
  column actor_user_id type=text nullable=true default=<none>
  column created_at type=timestamp with time zone nullable=false default=<none>
  column id type=text nullable=false default=<none>
  column payload type=text nullable=false default=''::text
  column target_user_id type=text nullable=true default=<none>
  index audit_events_pkey CREATE UNIQUE INDEX audit_events_pkey ON public.audit_events USING btree (id)
  index idx_audit_events_actor CREATE INDEX idx_audit_events_actor ON public.audit_events USING btree (actor_user_id, created_at)
  index idx_audit_events_created_at CREATE INDEX idx_audit_events_created_at ON public.audit_events USING btree (created_at)
  index idx_audit_events_target CREATE INDEX idx_audit_events_target ON public.audit_events USING btree (target_user_id, created_at)
table ca_signer_keys
  column created_at type=timestamp with time zone nullable=false default=<none>
  column expires_at type=timestamp with time zone nullable=false default=<none>
  column fingerprint type=text nullable=false default=<none>
  column public_key type=text nullable=false default=<none>
  column updated_at type=timestamp with time zone nullable=false default=<none>
  index ca_signer_keys_pkey CREATE UNIQUE INDEX ca_signer_keys_pkey ON public.ca_signer_keys USING btree (fingerprint)
  index idx_ca_signer_keys_expires_at CREATE INDEX idx_ca_signer_keys_expires_at ON public.ca_signer_keys USING btree (expires_at)
table certificate_request_decisions
  column accept_language type=text nullable=false default=''::text
  column certificate_request_id type=text nullable=false default=<none>
  column decided_at type=timestamp with time zone nullable=false default=<none>
  column email type=text nullable=false default=''::text
  column forwarded_for type=text nullable=false default=''::text
  column granted_options type=text nullable=false default=''::text
  column groups type=text nullable=false default=''::text
  column id type=text nullable=false default=<none>
  column other_accounts type=text nullable=false default=''::text
  column outcome type=text nullable=false default=<none>
  column policy_explanation type=text nullable=false default=''::text
  column principals type=text nullable=false default=''::text
  column service_accounts type=text nullable=false default=''::text
  column source_ip type=text nullable=false default=''::text
  column subject type=text nullable=false default=''::text
  column user_agent type=text nullable=false default=''::text
  column username type=text nullable=false default=''::text
  check chk_certificate_request_decisions_outcome (outcome = ANY (ARRAY['approved'::text, 'denied'::text]))
  index certificate_request_decisions_certificate_request_id_key CREATE UNIQUE INDEX certificate_request_decisions_certificate_request_id_key ON public.certificate_request_decisions USING btree (certificate_request_id)
  index certificate_request_decisions_pkey CREATE UNIQUE INDEX certificate_request_decisions_pkey ON public.certificate_request_decisions USING btree (id)
  index idx_certificate_request_decisions_decided_at CREATE INDEX idx_certificate_request_decisions_decided_at ON public.certificate_request_decisions USING btree (decided_at)
  index idx_certificate_request_decisions_source_ip CREATE INDEX idx_certificate_request_decisions_source_ip ON public.certificate_request_decisions USING btree (source_ip)
  index idx_certificate_request_decisions_subject CREATE INDEX idx_certificate_request_decisions_subject ON public.certificate_request_decisions USING btree (subject)
table certificate_requests
  column caller_pid type=bigint nullable=true default=<none>
  column caller_ppid type=bigint nullable=true default=<none>
  column caller_uid type=bigint nullable=true default=<none>
  column claim_token_hash type=text nullable=true default=<none>
  column claim_user_agent type=text nullable=false default=''::text
  column claimed_at type=timestamp with time zone nullable=true default=<none>
  column client type=text nullable=false default=''::text
  column client_mode type=text nullable=false default=''::text
  column client_time type=timestamp with time zone nullable=true default=<none>
  column created_at type=timestamp with time zone nullable=false default=<none>
  column enrollment_token type=text nullable=false default=''::text
  column failure_reason type=text nullable=false default=''::text
  column hostname type=text nullable=false default=''::text
  column id type=text nullable=false default=<none>
  column local_hostname type=text nullable=false default=''::text
  column local_username type=text nullable=false default=''::text
  column machine_id type=text nullable=false default=''::text
  column os type=text nullable=false default=''::text
  column pam_service type=text nullable=false default=''::text
  column process type=text nullable=false default=''::text
  column public_key type=text nullable=false default=<none>
  column remote_host type=text nullable=false default=''::text
  column requested_options type=text nullable=false default=''::text
  column requesting_user type=text nullable=false default=''::text
  column resolved_at type=timestamp with time zone nullable=true default=<none>
  column serial_number type=bigint nullable=true default=<none>
  column service_account type=text nullable=false default=''::text
  column source_ip type=text nullable=false default=''::text
  column status type=text nullable=false default=<none>
  column trusted_ca_fingerprints type=text nullable=false default=''::text
  column tty type=text nullable=false default=''::text
  column type type=text nullable=false default=<none>
  column user_code type=text nullable=false default=''::text
  column user_id type=text nullable=true default=<none>
  column username type=text nullable=false default=''::text
  check chk_certificate_requests_status (status = ANY (ARRAY['pending'::text, 'signing'::text, 'approved'::text, 'enrolled'::text, 'denied'::text, 'expired'::text, 'failed'::text]))
  check chk_certificate_requests_type (type = ANY (ARRAY['user'::text, 'service'::text, 'pam'::text, 'console'::text]))
  fk user_id -> users.id
  index certificate_requests_pkey CREATE UNIQUE INDEX certificate_requests_pkey ON public.certificate_requests USING btree (id)
  index idx_certificate_requests_status_created_at CREATE INDEX idx_certificate_requests_status_created_at ON public.certificate_requests USING btree (status, created_at)
  index idx_certificate_requests_user_code CREATE UNIQUE INDEX idx_certificate_requests_user_code ON public.certificate_requests USING btree (user_code) WHERE ((user_code <> ''::text) AND (status = ANY (ARRAY['pending'::text, 'signing'::text])))
  index idx_certificate_requests_user_id CREATE INDEX idx_certificate_requests_user_id ON public.certificate_requests USING btree (user_id)
table certificates
  column certificate_request_id type=text nullable=true default=<none>
  column critical_options type=text nullable=false default=''::text
  column expires_at type=timestamp with time zone nullable=false default=<none>
  column extensions type=text nullable=false default=''::text
  column id type=text nullable=false default=<none>
  column issued_at type=timestamp with time zone nullable=false default=<none>
  column key_id type=text nullable=false default=''::text
  column principals type=text nullable=false default=''::text
  column public_key_fingerprint type=text nullable=false default=<none>
  column serial_number type=bigint nullable=false default=<none>
  column type type=text nullable=false default=<none>
  column user_id type=text nullable=true default=<none>
  check chk_certificates_type (type = ANY (ARRAY['user'::text, 'service'::text, 'pam'::text, 'console'::text]))
  fk certificate_request_id -> certificate_requests.id
  fk user_id -> users.id
  index certificates_pkey CREATE UNIQUE INDEX certificates_pkey ON public.certificates USING btree (id)
  index certificates_serial_number_key CREATE UNIQUE INDEX certificates_serial_number_key ON public.certificates USING btree (serial_number)
  index idx_certificates_certificate_request_id CREATE INDEX idx_certificates_certificate_request_id ON public.certificates USING btree (certificate_request_id)
  index idx_certificates_user_id_issued_at CREATE INDEX idx_certificates_user_id_issued_at ON public.certificates USING btree (user_id, issued_at DESC)
table enrollment_reassignments
  column enrollment_id type=text nullable=false default=<none>
  column from_user_id type=text nullable=false default=<none>
  column id type=text nullable=false default=<none>
  column reassigned_at type=timestamp with time zone nullable=false default=<none>
  column reassigned_by_user_id type=text nullable=false default=<none>
  column to_user_id type=text nullable=false default=<none>
  index enrollment_reassignments_pkey CREATE UNIQUE INDEX enrollment_reassignments_pkey ON public.enrollment_reassignments USING btree (id)
  index idx_enrollment_reassignments_enrollment_id CREATE INDEX idx_enrollment_reassignments_enrollment_id ON public.enrollment_reassignments USING btree (enrollment_id)
  index idx_enrollment_reassignments_reassigned_at CREATE INDEX idx_enrollment_reassignments_reassigned_at ON public.enrollment_reassignments USING btree (reassigned_at)
  index idx_enrollment_reassignments_reassigned_by CREATE INDEX idx_enrollment_reassignments_reassigned_by ON public.enrollment_reassignments USING btree (reassigned_by_user_id)
table enrollment_retrievals
  column certificate_serial type=bigint nullable=false default=<none>
  column enrollment_id type=text nullable=false default=<none>
  column id type=text nullable=false default=<none>
  column retrieved_at type=timestamp with time zone nullable=false default=<none>
  column source_ip type=text nullable=false default=''::text
  column succeeded type=boolean nullable=false default=false
  fk enrollment_id -> enrollments.id
  index enrollment_retrievals_pkey CREATE UNIQUE INDEX enrollment_retrievals_pkey ON public.enrollment_retrievals USING btree (id)
  index idx_enrollment_retrievals_certificate_serial CREATE INDEX idx_enrollment_retrievals_certificate_serial ON public.enrollment_retrievals USING btree (certificate_serial)
  index idx_enrollment_retrievals_enrollment_id CREATE INDEX idx_enrollment_retrievals_enrollment_id ON public.enrollment_retrievals USING btree (enrollment_id)
table enrollments
  column certificate_duration_seconds type=bigint nullable=true default=<none>
  column certificate_request_id type=text nullable=true default=<none>
  column code type=text nullable=false default=<none>
  column created_at type=timestamp with time zone nullable=false default=<none>
  column expires_at type=timestamp with time zone nullable=false default=<none>
  column expiry_reminder_sent_at type=timestamp with time zone nullable=true default=<none>
  column id type=text nullable=false default=<none>
  column key_id type=text nullable=false default=''::text
  column last_expired_attempt_notified_at type=timestamp with time zone nullable=true default=<none>
  column notification_email type=text nullable=false default=''::text
  column option_set type=text nullable=false default=''::text
  column principals type=text nullable=false default=''::text
  column public_key type=text nullable=false default=<none>
  column redeemed_at type=timestamp with time zone nullable=true default=<none>
  column service_account type=text nullable=false default=''::text
  column user_id type=text nullable=false default=<none>
  fk certificate_request_id -> certificate_requests.id
  fk user_id -> users.id
  index enrollments_pkey CREATE UNIQUE INDEX enrollments_pkey ON public.enrollments USING btree (id)
  index idx_enrollments_code CREATE UNIQUE INDEX idx_enrollments_code ON public.enrollments USING btree (code)
  index idx_enrollments_expiry_reminder CREATE INDEX idx_enrollments_expiry_reminder ON public.enrollments USING btree (expiry_reminder_sent_at, expires_at)
  index idx_enrollments_service_account CREATE INDEX idx_enrollments_service_account ON public.enrollments USING btree (service_account)
  index idx_enrollments_user_id CREATE INDEX idx_enrollments_user_id ON public.enrollments USING btree (user_id)
table notification_preferences
  column created_at type=timestamp with time zone nullable=false default=<none>
  column enabled type=boolean nullable=false default=false
  column id type=text nullable=false default=<none>
  column kind type=text nullable=false default=<none>
  column updated_at type=timestamp with time zone nullable=false default=<none>
  column user_id type=text nullable=false default=<none>
  fk user_id -> users.id
  index idx_notification_preferences_user_kind CREATE UNIQUE INDEX idx_notification_preferences_user_kind ON public.notification_preferences USING btree (user_id, kind)
  index notification_preferences_pkey CREATE UNIQUE INDEX notification_preferences_pkey ON public.notification_preferences USING btree (id)
table server_secrets
  column created_at type=timestamp with time zone nullable=false default=<none>
  column name type=text nullable=false default=<none>
  column value type=bytea nullable=false default=<none>
  index server_secrets_pkey CREATE UNIQUE INDEX server_secrets_pkey ON public.server_secrets USING btree (name)
table user_groups
  column first_seen_at type=timestamp with time zone nullable=false default=<none>
  column group_name type=text nullable=false default=<none>
  column id type=text nullable=false default=<none>
  column last_seen_at type=timestamp with time zone nullable=false default=<none>
  column source type=text nullable=false default=<none>
  column user_id type=text nullable=false default=<none>
  check chk_user_groups_source (source = ANY (ARRAY['oidc'::text, 'ldap'::text]))
  fk user_id -> users.id
  index idx_user_groups_name CREATE INDEX idx_user_groups_name ON public.user_groups USING btree (group_name)
  index idx_user_groups_unique CREATE UNIQUE INDEX idx_user_groups_unique ON public.user_groups USING btree (user_id, group_name, source)
  index idx_user_groups_user CREATE INDEX idx_user_groups_user ON public.user_groups USING btree (user_id)
  index user_groups_pkey CREATE UNIQUE INDEX user_groups_pkey ON public.user_groups USING btree (id)
table user_ldap
  column attributes type=text nullable=false default=''::text
  column consecutive_misses type=integer nullable=false default=0
  column created_at type=timestamp with time zone nullable=false default=<none>
  column dn type=text nullable=false default=''::text
  column last_seen_at type=timestamp with time zone nullable=true default=<none>
  column last_synced_at type=timestamp with time zone nullable=true default=<none>
  column updated_at type=timestamp with time zone nullable=false default=<none>
  column user_id type=text nullable=false default=<none>
  fk user_id -> users.id
  index user_ldap_pkey CREATE UNIQUE INDEX user_ldap_pkey ON public.user_ldap USING btree (user_id)
table users
  column created_at type=timestamp with time zone nullable=false default=<none>
  column disabled_at type=timestamp with time zone nullable=true default=<none>
  column disabled_by_user_id type=text nullable=true default=<none>
  column disabled_reason type=text nullable=false default=''::text
  column disabled_source type=text nullable=true default=<none>
  column email type=text nullable=false default=''::text
  column extra_fields type=text nullable=false default=''::text
  column id type=text nullable=false default=<none>
  column other_accounts type=text nullable=false default=''::text
  column service_accounts type=text nullable=false default=''::text
  column subject type=text nullable=false default=<none>
  column updated_at type=timestamp with time zone nullable=false default=<none>
  column username type=text nullable=false default=<none>
  fk disabled_by_user_id -> users.id
  index idx_users_subject CREATE UNIQUE INDEX idx_users_subject ON public.users USING btree (subject)
  index users_pkey CREATE UNIQUE INDEX users_pkey ON public.users USING btree (id)
