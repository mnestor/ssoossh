table nss_audit_refs
  column created_at type=timestamp with time zone nullable=false default=<none>
  column event_id type=text nullable=false default=<none>
  column kind type=text nullable=false default=<none>
  column row_id type=text nullable=false default=<none>
  check nss_audit_refs_kind_check (kind = ANY (ARRAY['account'::text, 'group'::text]))
  fk event_id -> audit_events.id on_delete=CASCADE on_update=NO ACTION
  index idx_nss_audit_refs_row CREATE INDEX idx_nss_audit_refs_row ON public.nss_audit_refs USING btree (kind, row_id, created_at, event_id)
  index nss_audit_refs_pkey CREATE UNIQUE INDEX nss_audit_refs_pkey ON public.nss_audit_refs USING btree (event_id, kind, row_id)
table nss_collisions
  column first_seen_at type=timestamp with time zone nullable=false default=<none>
  column holder_id type=text nullable=false default=<none>
  column kind type=text nullable=false default=<none>
  column last_seen_at type=timestamp with time zone nullable=false default=<none>
  column other_dn type=text nullable=false default=<none>
  column other_id type=text nullable=true default=<none>
  column other_name type=text nullable=false default=''::text
  column other_number type=bigint nullable=false default=<none>
  column value type=text nullable=false default=<none>
  check nss_collisions_kind_check (kind = ANY (ARRAY['uid'::text, 'user_name'::text, 'gid'::text, 'group_name'::text]))
  index idx_nss_collisions_holder_id CREATE INDEX idx_nss_collisions_holder_id ON public.nss_collisions USING btree (holder_id)
  index idx_nss_collisions_other_dn CREATE INDEX idx_nss_collisions_other_dn ON public.nss_collisions USING btree (other_dn)
  index idx_nss_collisions_other_id CREATE INDEX idx_nss_collisions_other_id ON public.nss_collisions USING btree (other_id) WHERE (other_id IS NOT NULL)
  index nss_collisions_pkey CREATE UNIQUE INDEX nss_collisions_pkey ON public.nss_collisions USING btree (kind, holder_id, other_dn)
table nss_key_usage
  column day type=timestamp with time zone nullable=false default=<none>
