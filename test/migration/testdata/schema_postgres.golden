  index idx_nss_key_usage_day CREATE INDEX idx_nss_key_usage_day ON public.nss_key_usage USING btree (day)
  index idx_nss_key_usage_key_day CREATE INDEX idx_nss_key_usage_key_day ON public.nss_key_usage USING btree (key_id, day)
  index nss_key_usage_pkey CREATE UNIQUE INDEX nss_key_usage_pkey ON public.nss_key_usage USING btree (key_id, source_ip, generation, day)
