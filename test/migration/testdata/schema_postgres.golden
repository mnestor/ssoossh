  index server_secrets_pkey CREATE UNIQUE INDEX server_secrets_pkey ON public.server_secrets USING btree (name)
table user_groups
  column first_seen_at type=timestamp with time zone nullable=false default=<none>
  column group_name type=text nullable=false default=<none>
  column id type=text nullable=false default=<none>
  column last_seen_at type=timestamp with time zone nullable=false default=<none>
  column source type=text nullable=false default=<none>
  column user_id type=text nullable=false default=<none>
  check chk_user_groups_source (source = ANY (ARRAY['oidc'::text, 'ldap'::text]))
  fk user_id -> users.id on_delete=CASCADE on_update=NO ACTION
  index idx_user_groups_name CREATE INDEX idx_user_groups_name ON public.user_groups USING btree (group_name)
