FROM ubuntu:26.04

LABEL org.opencontainers.image.source="https://github.com/mnestor/ssoossh"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.description="ubuntu image with build tools and certficate chain"

ARG DEBIAN_FRONTEND=noninteractive
# zig cross-compiles ssoosshd's cgo build -- server-linux-pkcs11-build, the
# only one that needs it -- against a pinned glibc 2.28 floor. The default
# server build is CGO_ENABLED=0 and needs no cross-toolchain at all. Keep in
# sync with the zig version pinned in ssoossh's release workflow. 0.16 is
# kept as the floor because that pin is shared, not because the musl
# reasoning that first chose it still applies: there is no musl server build
# any more.
ARG ZIG_VERSION=0.16.0
# bomutils has not cut a tag since 2014; see the install step below for why
# this is a commit rather than a version.
ARG BOMUTILS_COMMIT=c247002e2f49878bab32dd0fcf805810ae0992cb
ARG RCODESIGN_VERSION=0.29.0
# rclone from upstream, not from apt. Ubuntu ships 1.60, which predates
# rclone knowing that Cloudflare R2 implements no ACLs: it puts
# "x-amz-acl: private" on every upload and R2 answers 501 NotImplemented.
# Current rclone omits the header entirely when the provider is Cloudflare.
ARG RCLONE_VERSION=1.75.1
# Tools baked in so CI steps don't fetch them on every run. Each is pinned,
# and each pin is the one the workflow that used to install it asked for:
#   golangci-lint  was golangci/golangci-lint-action's `version:` in lint.yaml
#   govulncheck    was `go run ...@v1.7.0` in security.yaml
#   redocly        was `npx @redocly/cli@...` in the Makefile's openapi-lint
#   actionlint     was `go run ...@v1.7.12` in the Makefile's actionlint,
#                  which pulled a second Go toolchain down with it
# Bumping one here is the whole change; nothing pins them a second time.
# golangci-lint must stay v2.x: .golangci.yml is a `version: "2"` config,
# which v1 cannot parse at all.
ARG GOLANGCI_LINT_VERSION=2.13.1
ARG GOVULNCHECK_VERSION=v1.7.0
ARG REDOCLY_VERSION=1.28.1
ARG ACTIONLINT_VERSION=v1.7.12
# Must be >= the `go` directive in go.mod, and should track the same pin as
# Dockerfile.devcontainer. GOTOOLCHAIN=auto covers `go build`/`go test` by
# downloading a newer toolchain on demand, but it cannot rescue govulncheck:
# that is a prebuilt binary that type-checks the module in-process with the
# go/types it was compiled against, so an image older than go.mod fails every
# package with "requires newer Go version ... (application built with ...)".
ARG GO_VERSION=1.27.0
RUN echo "deb [trusted=yes] https://repo.goreleaser.com/apt/ /" > /etc/apt/sources.list.d/goreleaser.list \
  && apt-get update && apt-get install -y --no-install-recommends gnupg curl ca-certificates \
  && curl -sSfL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
  && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
  && curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
  && apt-get update &&  apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    google-chrome-stable nodejs openssh-server \
    sudo build-essential git curl unzip jq gh goreleaser \
    # Both ship on the stock ubuntu-latest runner but not here, and
    # --no-install-recommends means nothing else drags them in: `file`
    # backs build.yaml's linkage check (the default build must be static
    # and the pkcs11 build must not be), netcat backs the e2e
    # proxycommand tests, which exec /usr/bin/nc.
    file netcat-openbsd \
    # CLI only, no daemon: GitHub-hosted runners mount the host's
    # /var/run/docker.sock into a container: job automatically, so this
    # talks to that daemon rather than running its own. Backs
    # build.yaml's goreleaser step, whose dockers_v2 pipe shells out to
    # `docker buildx build`; buildx itself comes from
    # docker/setup-buildx-action in that workflow, not baked in here.
    docker.io \
    # softhsm2 + opensc (pkcs11-tool) back ssoossh's HSM signing tests
    softhsm2 opensc xz-utils \
    # apt-utils supplies apt-ftparchive and createrepo-c supplies
    # createrepo_c: the two index writers scripts/gen-repo.sh shells out to
    # when it builds the signed apt and yum trees from the release's own
    # packages. rpm is there for the same script's query of each package's
    # Release field, which is what decides the EL major it is filed under --
    # the file name does not carry it. None of the three ships in the base
    # image.
    apt-utils createrepo-c rpm \
    # The macOS installer is assembled here rather than on a macOS runner
    # (packaging/macos/flatpkg.sh): xar writes the flat package's archive,
    # and libarchive-tools supplies bsdcpio for its payload. bsdcpio and not
    # GNU cpio, which is not a substitute: GNU cpio strips the leading "./"
    # from every stored path, leaving the payload disagreeing with the BOM
    # about every file in the package.
    xar libarchive-tools \
    # The Windows installer is assembled here too
    # (packaging/windows/msi.sh): wixl reads WiX v3 source and writes the
    # MSI, with no wine, no .NET and no Windows SDK. In universe, which the
    # ubuntu base image enables by default. msitools is the sibling package
    # holding msiinfo, used to inspect a built package.
    wixl msitools \
  # rclone uploads the generated repository to R2. Chosen over awscli for
  # --header-upload, which is how the package files and the metadata get the
  # different cache lifetimes they need. Installed from upstream for the
  # reason given at RCLONE_VERSION above.
  && curl -fsSL -o /tmp/rclone.zip \
       https://downloads.rclone.org/v${RCLONE_VERSION}/rclone-v${RCLONE_VERSION}-linux-amd64.zip \
  && unzip -q -j /tmp/rclone.zip "rclone-v${RCLONE_VERSION}-linux-amd64/rclone" -d /usr/local/bin \
  && chmod 0755 /usr/local/bin/rclone \
  && rm -f /tmp/rclone.zip \
  && curl -sL -o /tmp/quill.deb $(curl -s https://api.github.com/repos/anchore/quill/releases/latest | jq -r '.assets[] |select(.name|match("linux_amd64.deb$")) | .browser_download_url') \
  && dpkg -i /tmp/quill.deb \
  # mkbom, which writes the flat package's BOM. Pinned to a commit and not
  # to a tag deliberately: upstream's newest tag is 0.2, from 2014, and the
  # five commits to src/ since then include the fix for a build error on any
  # C++17 toolchain, an arm64 argument-parsing fix, a modtime fix, and a
  # buffer overflow fix in mkbom itself. The tag builds neither cleanly nor
  # correctly here.
  && git init /tmp/bomutils \
  && git -C /tmp/bomutils fetch --depth 1 https://github.com/hogliux/bomutils ${BOMUTILS_COMMIT} \
  && git -C /tmp/bomutils checkout FETCH_HEAD \
  && make -C /tmp/bomutils install \
  # rcodesign signs the flat package, submits it to Apple's notary service
  # and staples the ticket, all from Linux. It is also what removed the
  # keychain handling the old macOS script needed: it parses a PKCS#12
  # itself, so neither P12 shape is a problem any more.
  && curl -fsSL https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign%2F${RCODESIGN_VERSION}/apple-codesign-${RCODESIGN_VERSION}-x86_64-unknown-linux-musl.tar.gz \
     | tar -C /tmp -xz \
  && mv /tmp/apple-codesign-${RCODESIGN_VERSION}-x86_64-unknown-linux-musl/rcodesign /usr/local/bin/rcodesign \
  && curl -fsSL https://get.pnpm.io/install.sh | ENV="$HOME/.bashrc" SHELL="$(which bash)" bash - \
  && curl -sL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz \
  && curl -sL https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz | tar -C /usr/local -xJ \
  && ln -s /usr/local/zig-x86_64-linux-${ZIG_VERSION}/zig /usr/local/bin/zig \
  && /usr/local/go/bin/go install gotest.tools/gotestsum@v1.13.0 \
  && /usr/local/go/bin/go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
  && /usr/local/go/bin/go install github.com/rhysd/actionlint/cmd/actionlint@${ACTIONLINT_VERSION} \
  # The release tarball rather than `go install`: it is the artifact
  # golangci-lint publishes and supports, and it keeps the linter's very
  # large dependency tree out of this module's go.sum.
  && curl -fsSL https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz \
     | tar -C /tmp -xz \
  && mv /tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64/golangci-lint /usr/local/bin/golangci-lint \
  && npm install -g @redocly/cli@${REDOCLY_VERSION} \
  # GitHub mounts the workspace owned by the runner's uid while this
  # container runs as root; without this every git call (and the Makefile's
  # $(shell git ...) version stamps) dies with "dubious ownership".
  && git config --system --add safe.directory '*' \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# pnpm's installer only wires PATH into /root/.bashrc, which CI steps never
# source, so its home has to be on PATH explicitly.
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=/usr/local/go/bin:/root/go/bin:$PNPM_HOME/bin:$PATH

