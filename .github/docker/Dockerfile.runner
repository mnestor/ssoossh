FROM ubuntu:26.04

LABEL org.opencontainers.image.source="https://github.com/mnestor/ssoossh"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.description="ubuntu image with build tools and certficate chain"

ARG DEBIAN_FRONTEND=noninteractive
# zig cross-compiles ssoosshd's cgo (PKCS#11) build against a pinned glibc
# floor and musl; keep in sync with the zig version pinned in ssoossh's
# release workflow. 0.16 is a floor: earlier zig cc took -dynamic on a musl
# target and linked libc statically anyway, and a static musl binary cannot
# dlopen a PKCS#11 module.
ARG ZIG_VERSION=0.16.0
# Tools baked in so CI steps don't fetch them on every run. Each is pinned,
# and each pin is the one the workflow that used to install it asked for:
#   golangci-lint  was golangci/golangci-lint-action's `version:` in lint.yaml
#   govulncheck    was `go run ...@v1.7.0` in security.yaml
#   redocly        was `npx @redocly/cli@...` in the Makefile's openapi-lint
#   actionlint     was `go run ...@v1.7.12` in the Makefile's actionlint,
#                  which pulled a second Go toolchain down with it
# Bumping one here is the whole change; nothing pins them a second time.
# golangci-lint must stay v2.x: .golangci.yml is a `version: "2"` config,
# which v1 cannot parse at all.
ARG GOLANGCI_LINT_VERSION=2.13.1
ARG GOVULNCHECK_VERSION=v1.7.0
ARG REDOCLY_VERSION=1.28.1
ARG ACTIONLINT_VERSION=v1.7.12
RUN echo "deb [trusted=yes] https://repo.goreleaser.com/apt/ /" > /etc/apt/sources.list.d/goreleaser.list \
  # Registered before the first apt-get update so :arm64 packages below
  # resolve. Ubuntu's default archive.ubuntu.com/security.ubuntu.com
  # mirrors carry arm64 packages directly on this release -- no
  # ports.ubuntu.com juggling needed (verified against this same base
  # image).
  && dpkg --add-architecture arm64 \
  && apt-get update && apt-get install -y --no-install-recommends gnupg curl ca-certificates \
  && curl -sSfL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
  && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
  && curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
  && apt-get update &&  apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    google-chrome-stable nodejs openssh-server \
    sudo build-essential git curl unzip jq gh goreleaser \
    # libpam0g-dev is Multi-Arch: same, so both variants co-install; the
    # :arm64 one depends on (and so pulls in) the matching libpam0g:arm64
    # runtime .so -- both are needed for build-pam's zig cross-link step
    # below to find a real libpam.so.0 instead of silently falling back
    # to statically linking libpam.a (see .goreleaser-pam.yml).
    libpam0g-dev libpam0g-dev:arm64 \
    # Both ship on the stock ubuntu-latest runner but not here, and
    # --no-install-recommends means nothing else drags them in: `file`
    # backs build.yaml's musl linkage check, netcat backs the e2e
    # proxycommand tests, which exec /usr/bin/nc.
    file netcat-openbsd \
    # CLI only, no daemon: GitHub-hosted runners mount the host's
    # /var/run/docker.sock into a container: job automatically, so this
    # talks to that daemon rather than running its own. Backs
    # build.yaml's goreleaser step, whose dockers_v2 pipe shells out to
    # `docker buildx build`; buildx itself comes from
    # docker/setup-buildx-action in that workflow, not baked in here.
    docker.io \
    # softhsm2 + opensc (pkcs11-tool) back ssoossh's HSM signing tests
    softhsm2 opensc xz-utils \
  && curl -sL -o /tmp/quill.deb $(curl -s https://api.github.com/repos/anchore/quill/releases/latest | jq -r '.assets[] |select(.name|match("linux_amd64.deb$")) | .browser_download_url') \
  && dpkg -i /tmp/quill.deb \
  && curl -fsSL https://get.pnpm.io/install.sh | ENV="$HOME/.bashrc" SHELL="$(which bash)" bash - \
  && curl -sL https://go.dev/dl/go1.26.6.linux-amd64.tar.gz | tar -C /usr/local -xz \
  && curl -sL https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz | tar -C /usr/local -xJ \
  && ln -s /usr/local/zig-x86_64-linux-${ZIG_VERSION}/zig /usr/local/bin/zig \
  # A private copy of just the PAM headers (arch-independent, so one copy
  # covers both build-pam targets) for CGO_CFLAGS to point at. zig cc
  # ships its own versioned glibc headers for whichever -target ...gnu.N.NN
  # floor it's building against; pointing CGO_CFLAGS at the real
  # /usr/include instead would pull those glibc headers in too and
  # collide with zig's bundled ones (__GLIBC_MINOR__ redefined, etc).
  && mkdir -p /opt/pam-include/security \
  && cp /usr/include/security/*.h /opt/pam-include/security/ \
  && /usr/local/go/bin/go install gotest.tools/gotestsum@v1.13.0 \
  && /usr/local/go/bin/go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
  && /usr/local/go/bin/go install github.com/rhysd/actionlint/cmd/actionlint@${ACTIONLINT_VERSION} \
  # The release tarball rather than `go install`: it is the artifact
  # golangci-lint publishes and supports, and it keeps the linter's very
  # large dependency tree out of this module's go.sum.
  && curl -fsSL https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz \
     | tar -C /tmp -xz \
  && mv /tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64/golangci-lint /usr/local/bin/golangci-lint \
  && npm install -g @redocly/cli@${REDOCLY_VERSION} \
  # GitHub mounts the workspace owned by the runner's uid while this
  # container runs as root; without this every git call (and the Makefile's
  # $(shell git ...) version stamps) dies with "dubious ownership".
  && git config --system --add safe.directory '*' \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# pnpm's installer only wires PATH into /root/.bashrc, which CI steps never
# source, so its home has to be on PATH explicitly.
ENV PNPM_HOME=/root/.local/share/pnpm
ENV PATH=/usr/local/go/bin:/root/go/bin:$PNPM_HOME/bin:$PATH

