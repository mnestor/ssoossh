audit.logging.log_json = true
audit.max_rows = 1000000
audit.retention = 1440h
audit.sweep_interval = 1h
authentication.fields.email = email
authentication.fields.groups = groups
authentication.fields.name = name
authentication.fields.subject = sub
authentication.fields.username = preferred_username
authentication.scopes = profile email
cert_options.client_timeout = 5m
cert_options.console.client_timeout = 2m
cert_options.console.valid_duration = 30s
cert_options.pam.valid_duration = 30s
cert_options.service.enrollment_duration = 8760h
cert_options.service.valid_duration = 8760h
cert_options.user.extensions[0] = permit-pty
cert_options.user.extensions[1] = permit-user-rc
cert_options.user.valid_duration = 30s
db.connection_string = ssoossh.db
db.logging.level = WARN
db.max_idle_conns = 5
db.max_open_conns = 10
db.provider = sqlite
db.retry_attempts = 3
db.retry_interval = 3s
http.access_logging.level = info
http.access_logging.log_client_ip = true
http.access_logging.log_request_header = true
http.access_logging.log_user_agent = true
http.address = 127.0.0.1
http.cert_request_rate_limit.console = 10
http.cert_request_rate_limit.pam = 10
http.cert_request_rate_limit.service_enroll = 5
http.cert_request_rate_limit.user = 10
http.console_code_rate_limit.burst = 5
http.console_code_rate_limit.limit = 1
http.cookie_idle_timeout = 30m
http.cookie_max_age = 9h
http.cookie_same_site = strict
http.hsts = max-age=31536000; includeSubDomains
http.port = 8080
http.rate_duration = 1m
http.rate_limit = 60
http.service_code_rate_limit.limit = 1
http.tls.min_version = TLS1.3
ldap.limits.max_attributes_bytes = 65536
ldap.limits.max_entries_per_search = 1000
ldap.limits.max_values_per_attribute = 1000
ldap.sync.disable_after = 45m
ldap.sync.interval = 15m
ldap.sync.reenable = true
ldap.timeout = 5s
logging.include_app_name = true
logging.include_app_version = true
logging.level = WARN
mail.expired_attempt_window = 24h
mail.expiry_reminder_lead = 168h
mail.logging.level = info
mail.smtp.auth = none
mail.smtp.host = localhost
mail.smtp.port = 25
mail.smtp.timeout = 15s
mail.smtp.tls = opportunistic
max_cert_lifetime = 2160h
max_service_cert_lifetime = 17544h
production = true
pubsub.backend = gochannel
version.mode = show
