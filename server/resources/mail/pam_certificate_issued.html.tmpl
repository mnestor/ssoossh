<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#1c1e21;max-width:640px">
  <p>
    A certificate was issued to authenticate a local operation as you: a <code>sudo</code>, a
    <code>su</code>, or another PAM-guarded command on the machine below.
  </p>
  <p>If you just ran that command and answered the prompt, this is it.</p>
  <p style="background:#fdeced;border-left:3px solid #c0392b;padding:10px 14px;margin:0 0 18px">
    If you did not, someone completed a PAM authentication in your name, which means they were
    already at a shell on that machine. Tell whoever runs it.
  </p>

  <h3 style="margin:24px 0 8px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#6b7280">Certificate</h3>
  <p style="margin:0 0 10px;color:#6b7280;font-size:13px">
    A PAM certificate authorizes one local operation and is deliberately short-lived. It is not an
    SSH login credential and cannot open a session.
  </p>
  <table cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:14px">
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Principals</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ join .Principals ", " }}</td></tr>
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Key ID</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .KeyID }}</td></tr>
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Serial number</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .Serial }}</td></tr>
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Key fingerprint</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .PublicKeyFingerprint }}</td></tr>
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Valid period</td><td style="padding:4px 0">{{ datetime .IssuedAt }} &ndash; {{ datetime .ExpiresAt }} <span style="color:#6b7280">({{ remaining .ExpiresAt }})</span></td></tr>
    {{ if or .Extensions .NoTouchRequired }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Extensions</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ join .Extensions ", " }}{{ if .NoTouchRequired }}{{ if .Extensions }}, {{ end }}no-touch-required{{ end }}</td></tr>{{ end }}
    {{ if or .ForceCommand .SourceAddresses }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Critical options</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ if .ForceCommand }}force-command = {{ .ForceCommand }}{{ end }}{{ if and .ForceCommand .SourceAddresses }}<br>{{ end }}{{ if .SourceAddresses }}source-address = {{ join .SourceAddresses ", " }}{{ end }}</td></tr>{{ end }}
  </table>

  <h3 style="margin:24px 0 8px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#6b7280">Decision</h3>
  <table cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:14px">
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Approved by</td><td style="padding:4px 0">{{ if .ApprovedByUsername }}<span style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .ApprovedByUsername }}{{ if .ApprovedByEmail }} &lt;{{ .ApprovedByEmail }}&gt;{{ end }}</span>{{ if not .ApprovedAt.IsZero }} <span style="color:#6b7280">at {{ datetime .ApprovedAt }}</span>{{ end }}{{ else }}<span style="color:#6b7280">not recorded</span>{{ end }}</td></tr>
    {{ if .ApprovedByName }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Name</td><td style="padding:4px 0">{{ .ApprovedByName }}</td></tr>{{ end }}
    {{ if .ApproverSourceIP }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Source address</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .ApproverSourceIP }}</td></tr>{{ end }}
    {{ if .ApproverUserAgent }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Browser</td><td style="padding:4px 0">{{ .ApproverUserAgent }}</td></tr>{{ end }}
  </table>
  <p style="color:#6b7280;font-size:13px">
    If that address is not one you were at, the approving account was not being used by you.
  </p>

  <h3 style="margin:24px 0 8px;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#6b7280">What asked for it</h3>
  <p style="margin:0 0 10px;color:#6b7280;font-size:13px">
    Reported by the requesting host and never verified. Only the address is what the server observed.
  </p>
  <table cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:14px">
    {{ if or .LocalUsername .LocalHostname }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Reported as</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .LocalUsername }}{{ if and .LocalUsername .LocalHostname }}@{{ end }}{{ .LocalHostname }}</td></tr>{{ end }}
    {{ if .PAMService }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Service</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .PAMService }}</td></tr>{{ end }}
    {{ if .TTY }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Terminal</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .TTY }}</td></tr>{{ end }}
    {{ if .RemoteHost }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Remote host</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .RemoteHost }}</td></tr>{{ end }}
    {{ if .RequestingUser }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Invoked by</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .RequestingUser }}</td></tr>{{ end }}
    {{ if .Process }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Command</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .Process }}</td></tr>{{ end }}
    {{ if .MachineID }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Machine ID</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .MachineID }}</td></tr>{{ end }}
    {{ if .Client }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Client</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .Client }}{{ if .ClientMode }} (mode={{ .ClientMode }}){{ end }}</td></tr>{{ end }}
    {{ if .OS }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Platform</td><td style="padding:4px 0">{{ .OS }}</td></tr>{{ end }}
    {{ if or .CallerUID .CallerPID }}<tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Process ids</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ if .CallerUID }}uid {{ .CallerUID }}{{ if .CallerGID }}, gid {{ .CallerGID }}{{ end }}{{ if .CallerPID }}, {{ end }}{{ end }}{{ if .CallerPID }}pid {{ .CallerPID }}{{ if .CallerPPID }}, ppid {{ .CallerPPID }}{{ end }}{{ end }}</td></tr>{{ end }}
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Requested from</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .SourceIP }}</td></tr>
    <tr><td style="padding:4px 12px 4px 0;color:#6b7280;white-space:nowrap">Request ID</td><td style="padding:4px 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace">{{ .RequestID }}</td></tr>
  </table>

  {{ if .ServerURL }}<p style="font-size:13px">Your <a href="{{ .ServerURL }}/logs/me" style="color:#1d4ed8">certificate history</a>.</p>{{ end }}

  <p style="margin-top:28px;padding-top:14px;border-top:1px solid #e5e7eb;color:#9099a8;font-size:12px">
    Sent because "PAM certificate issued" is on in your
    {{ if .ServerURL }}<a href="{{ .ServerURL }}/preferences" style="color:#6b7280">notification preferences</a>{{ else }}notification preferences{{ end }}.
    It is off by default.
  </p>
</div>
